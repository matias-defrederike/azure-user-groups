{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "rgName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Resource Group to create"
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region to deploy the Resource Group and resources"
      }
    },
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Application Name"
      }
    },
    "acrName": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry name (must be globally unique, without dashes)"
      }
    },
    "vpnPublicIp": {
      "type": "string",
      "metadata": {
        "description": "Public IP address of the VPN client to allow access to the Container App"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2022-09-01",
      "name": "[parameters('rgName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "appDeployment",
      "resourceGroup": "[parameters('rgName')]",
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('rgName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "appName": { "value": "[parameters('appName')]" },
          "acrName": { "value": "[parameters('acrName')]" },
          "vpnPublicIp": { "value": "[parameters('vpnPublicIp')]" },
          "location": { "value": "[parameters('location')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "appName": { "type": "string" },
            "acrName": { "type": "string" },
            "vpnPublicIp": { "type": "string" },
            "location": { "type": "string" }
          },
          "variables": {
            "logAnalyticsWorkspaceName": "[format('logs-{0}', parameters('appName'))]",
            "containerAppEnvironmentName": "[format('cae-{0}', parameters('appName'))]",
            "containerAppName": "[format('app-{0}', parameters('appName'))]",
            "uaiName": "id-aca-acrpull",
            "acrPullRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
            "helloWorldImage": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[variables('logAnalyticsWorkspaceName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": { "name": "PerGB2018" },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2023-05-01",
              "name": "[variables('containerAppEnvironmentName')]",
              "location": "[parameters('location')]",
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
              ],
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))).customerId]",
                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName')), '2022-10-01').primarySharedKey]"
                  }
                }
              }
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[variables('uaiName')]",
              "location": "[parameters('location')]"
            },
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[parameters('acrName')]",
              "location": "[parameters('location')]",
              "sku": { "name": "Standard" },
              "properties": { "adminUserEnabled": false }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), variables('uaiName'), variables('acrPullRoleDefinitionId'))]",
              "scope": "[format('Microsoft.ContainerRegistry/registries/{0}', parameters('acrName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[variables('acrPullRoleDefinitionId')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))).principalId]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2023-05-01",
              "name": "[variables('containerAppName')]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]": {}
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvironmentName'))]",
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), variables('uaiName'), variables('acrPullRoleDefinitionId')))]"
              ],
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvironmentName'))]",
                "configuration": {
                  "activeRevisionsMode": "Single",
                  "ingress": {
                    "external": true,
                    "targetPort": 80,
                    "allowInsecure": true,
                    "traffic": [ { "latestRevision": true, "weight": 100 } ],
                    "ipSecurityRestrictions": [
                      {
                        "name": "AllowMyIP",
                        "ipAddressRange": "[parameters('vpnPublicIp')]",
                        "action": "Allow"
                      }
                    ]
                  },
                  "registries": [
                    {
                      "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))).loginServer]",
                      "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
                    }
                  ]
                },
                "template": {
                  "containers": [
                    {
                      "name": "[format('container-{0}', parameters('appName'))]",
                      "image": "[variables('helloWorldImage')]",
                      "resources": { "cpu": 0.5, "memory": "1Gi" }
                    }
                  ]
                }
              }
            },
            {
              "type": "Microsoft.ContainerRegistry/registries/tasks",
              "apiVersion": "2019-06-01-preview",
              "name": "[format('{0}/PurgeOldImages', parameters('acrName'))]",
              "location": "[parameters('location')]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
              ],
              "properties": {
                "platform": { "os": "Linux" },
                "step": {
                  "type": "EncodedTask",
                  "encodedTaskContent": "dmVyc2lvbjogdjEuMS4wCnN0ZXBzOgogIC0gY21kOiBhY3IgcHVyZ2UgLS1maWx0ZXIgJ3lvdXJfaW1hZ2VfbmFtZTouKicgLS1rZWVwIDEwIC0tdW50YWdnZWQ=",
                  "contextPath": "/dev/null"
                },
                "trigger": {
                  "timerTriggers": [
                    {
                      "name": "daily_purge_schedule",
                      "schedule": "0 0 * * *",
                      "status": "Enabled"
                    }
                  ]
                }
              }
            }
          ],
          "outputs": {
            "app_url": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2023-05-01').configuration.ingress.fqdn)]"
            },
            "acr_id": {
              "type": "string",
              "value": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "app_url": {
      "type": "string",
      "value": "[reference('appDeployment').outputs.app_url.value]"
    },
    "acr_id": {
      "type": "string",
      "value": "[reference('appDeployment').outputs.acr_id.value]"
    }
  }
}